// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Deceased{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  ffhMemberNo                 String
  lastName                    String
  nickName            String @default("")
  firstNames                  String
  idNumber                    String
  dateOfBirth         DateTime
  dateOfDeath                 DateTime
  removalDate                 DateTime
  removalFrom                 Address
  removalTime                 String?

  deathCertificateRecipient   String
  createdBy                   String
  updatedBy           String? @default("")
  updated             DateTime? @updatedAt()
  flagDelete             Boolean @default(false)
 

  arrangement                 Arrangement?
  funeralProgram              FuneralProgram?
  removal                     Removal?

  @@unique([idNumber])

}

model Arrangement{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo           String
   dateOfFuneralService        DateTime?
  
  familyReps          FamilyRep[]
  deliveryAddress     String?
  deliveryTime        String?
  church              Church?
  minister            Minister?  
  arrangementAddOnItems              ArrangementAddOnItem[]
  crossSize           String?
  storage             Int
  storageDays         Int
  decor               Decor?
  totalDue        Int
  outstandingBalance          Int   @default(0)
  createdBy           String
  created             DateTime @default(now())
  updatedBy           String? @default("")
  updated             DateTime? @updatedAt()
  notes               String @default("")
  paidUp              Boolean
  receipts            Receipt[]
  additionalItems     AdditionalItems[]
  digger              Item
  bus                 Item
  graveTime           String
  flagDelete          Boolean @default(false)
  graveNo             String?
  discount            Int
  

  crossId             String? @db.ObjectId
  cross               CrossSize? @relation( fields: [crossId], references: [id])
  
  graveId             String @db.ObjectId
  grave               Grave @relation(fields: [graveId], references: [id])
  deceasedId          String @db.ObjectId @unique
  deceased            Deceased  @relation(fields: [deceasedId], references: [id], onDelete: Cascade)
  tombstoneId         String? @db.ObjectId
  tombstone           Tombstone? @relation(fields: [tombstoneId], references: [id])
  coffinId            String?  @db.ObjectId
  coffin              Coffin?    @relation(fields: [coffinId], references: [id])



}




type AdditionalItems{
  description         String
  amount              Int
}

model FuneralProgram {
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  survivedBy          String
  atHome              AtHome
  atChurch            AtChurch
  hymn               Hymn
  otherInformation               String
  needPallbearers     Boolean @default(true)
  pallbearersInHouse    Pallbearer[] 
  pallbearersOutHouse Pallbearer[] 
  pallbearersInChurch    Pallbearer[] 
  pallbearersOutChurch Pallbearer[] 
  pallbearersGrave    Pallbearer[] 
  languageOfProgram   String @default("")
  orbituaryText       String @default("")

  createdBy           String
  created             DateTime @default(now())
  updatedBy           String? @default("")
  updated             DateTime? @updatedAt()

  deceasedId          String @db.ObjectId @unique
  deceased            Deceased  @relation(fields: [deceasedId], references: [id], onDelete: Cascade)

}

model Removal{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  dateRequested       DateTime @default(now())
  invoiceNo           String
  byUndertaker        String
  deathRegistration   Int
  doctorsFees         Int
  storageFee            Int
  storageDays          Int
  graveFee            Int
  gravediggerCost     Int
  copies              Int
  copyFee             Int
  adminFees           Int
  totalDue            Int
  receipts            Receipt[]
  scheduledBy         String
  created             DateTime @default(now())
  updatedBy           String? @default("")
  updated             DateTime? @updatedAt()
  outstandingBalance  Int
  paidUp              Boolean @default(false)


  
  deceasedId          String @db.ObjectId @unique
  deceased            Deceased  @relation(fields: [deceasedId], references: [id], onDelete: Cascade)



}

model Receipt{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo           String
  date                DateTime
  issuedBy            String
  methodOfPayment     String @default("EFT")
  receivedAmount      Int @default(0)
  receivedFrom        String

  invoiceId           String @db.ObjectId
  removal             Removal? @relation(fields: [invoiceId],references: [id])
  arrangement         Arrangement? @relation(fields: [invoiceId],references: [id])
  invoice             Invoice? @relation(fields: [invoiceId],references: [id])




}


model Invoice{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo           String
  created                DateTime @default(now())
  dueDate             DateTime
  paymentReference    String
  customerDetails     Customer
  invoiceItems        InvoiceItem[]
  total               Int
  discount            Int
  paidUp                Boolean @default(false)
  createdBy           String
  flagDelete          Boolean

  receipts            Receipt[]

  @@unique([invoiceNo])

}

type InvoiceItem{
  description     String
  qty             Int
  unitPrice       Int
  totalPrice      Int
}

type Customer{
  firstName   String
  lastName    String
  phoneNo     String
  email       String
  address     Address


}

model AddOns{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  price               Int
}



model Tombstone{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  type                String
  tombstoneName                String @default("")
  price               Int
  arrangements        Arrangement[]
}

model Coffin{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  coffinName                String
  price               Int
  arrangements        Arrangement[]

}

model CrossSize{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  size                String
  price               Int
  arrangements        Arrangement[]

}

model Grave{
    id                  String @id @default(auto()) @map("_id") @db.ObjectId
    graveName           String
    price               Int
    arrangements        Arrangement[]

}

model Expense{
    id                  String @id @default(auto()) @map("_id") @db.ObjectId
    description         String    
    cost                Int
    createdOn           DateTime @default(now())
    flagged             Boolean @default(false)
    receiptUrl          String?

    vehicleId           String? @db.ObjectId
    vehicle             Vehicle? @relation(fields: [vehicleId], references: [id])

    subCatId            String @db.ObjectId
    subCategory         SubExpCategory @relation(fields: [subCatId], references: [id])

    categoryId          String @db.ObjectId
    category            ExpCategory @relation(fields: [categoryId], references: [id])




}

model ExpCategory{
    id                  String @id @default(auto()) @map("_id") @db.ObjectId
    name                String

    expenses            Expense[]
    subCategories       SubExpCategory[]


}

model SubExpCategory{
  id                    String @id @default(auto()) @map("_id") @db.ObjectId
  name                  String

  expenses            Expense[]
  expCategoryId          String @db.ObjectId
  expCategory           ExpCategory @relation(fields: [expCategoryId], references: [id])
}

model Vehicle{
  id                    String @id @default(auto()) @map("_id") @db.ObjectId
  registration          String
  colour                String
  odometer              Int
  model                 String
  addedOn               DateTime @default(now())
  available             Boolean @default(true)

  logs                  VehicleLog[]
  expenses              Expense[]
  
}


model VehicleLog{
  id                    String @id @default(auto()) @map("_id") @db.ObjectId
  driver                String  
  checkedOut            Checked
  checkedIn             Checked?

  vehicleId            String @db.ObjectId
  vehicle              Vehicle @relation(fields: [vehicleId], references: [id])
}


type Checked{
  time                DateTime
  odometerReading     Int
  // odometerPicture     String

}

type ArrangementAddOnItem{
  name      String
  qty       Int
  price     Int
}

type Pallbearer{
  firstName         String
  lastName          String

}


type Hymn{
  nameOfHymnBook      String
  hymns               HymnField[]
}

type HymnField{
  hymnNumber          Int
  detailsOfHymn       String
}

type AtHome{
  officiatingMinister   String
  startTime             String?
}

type AtChurch{
  officiatingMinister   String
  orbituary             String
  voteOfThanks          String
  otherItems            String
  startTime             String?
  endTime               String?
}

type Decor{
  candle              Item
  photo               Item
  glass               Item
  banner              Item


}

type Item{
  qty               Int
  price             Int
}

type Church{
  churchName        String
  Address     Address
  time          String
}



type Minister{
  firstName       String
  lastName        String
  phoneNo         String
}

type FamilyRep{
  firstName       String?
  lastName        String?
  relationship    String?
  phoneNo         String?
  email           String?
}

type Address{
  street          String
  city            String
}



