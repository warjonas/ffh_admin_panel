// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Arrangement{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo           String
  deceased            Deceased
  familyReps          FamilyRep[]
  deliveryAddress     String
  DeliveryTime        String
  church              Church
  cemetry             Cemetry
  minister            Minister  
  digger              Boolean @default(true)
  crossSize           String
  doves               Boolean
  liveStreaming       Boolean
  programs            Int
  familyCar           Boolean
  bus                 Boolean
  storageDays         Int
  decor               Decor
  totalPayable        Int
  amountPaid          Int   @default(0)
  createdBy           String
  notes               String @default("")
  afterHour                 Boolean

  doctor                 Boolean

  cremationDoctor                 Boolean

  
  tombstoneId         String @db.ObjectId
  tombstone           Tombstone @relation(fields: [tombstoneId], references: [id])
  coffinId            String  @db.ObjectId
  coffin              Coffin    @relation(fields: [coffinId], references: [id])

}

model FuneralProgram {
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  languageOfProgram   String
  firstNameOfDeceased String
  nickName            String @default("")
  lastNameOfDeceased  String
  dateOfBirth         DateTime
  dateOfDeath         DateTime
  survivedBy          String
  atHome              AtHome
  atChurch            AtChurch
  hymn               Hymn
  otherInformation               String
  needPallbearers     Boolean @default(true)
  pallbearersInHouse    Pallbearer[] 
  pallbearersOutHouse Pallbearer[] 
  pallbearersInChurch    Pallbearer[] 
  pallbearersOutChurch Pallbearer[] 
  pallbearersGrave    Pallbearer[] 

  orbituaryText       String @default("")

  createdBy           String


}

model Removal{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  lastname             String
  firstName           String
  idNumber            String
  address             String
  

  dateRemoved         DateTime
  byUndertaker        String
  deathRegistration   Int
  doctorsFees         Int
  storageFee          Int
  storageDays         Int
  copyFee             Int
  copies              Int
  graveFee            Int
  casket              Int
  gravediggerCost     Int
  adminFees           Int
  totalDue            Int
  receipts            RemovalReceipt[]
  scheduledBy         String



}

model RemovalReceipt{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo           String
  date                DateTime
  issuedBy            String
  methodOfPayment     String @default("EFT")
  receivedAmount      Int @default(0)
  outstandingBalance  Int
  receivedFrom        String

  removalId           String @db.ObjectId
  removal             Removal @relation(fields: [removalId],references: [id])


}



model Tombstone{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  type                String
  tombstoneName                String @default("")
  arrangements        Arrangement[]
}

model Coffin{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  coffinName                String
  price               Int
  arrangements        Arrangement[]

}

type Pallbearer{
  firstName         String
  lastName          String

}


type Hymn{
  nameOfHymnBook      String
  hymns               HymnField[]
}

type HymnField{
  hymnNumber          Int
  detailsOfHymn       String
}

type AtHome{
  officiatingMinister   String
}

type AtChurch{
  officiatingMinister   String
  orbituary             String
  voteOfThanks          String
  otherItems            String
}

type Decor{
  candle              Boolean @default(false)
  photo               Boolean @default(false)
  glass               Boolean @default(false)
  banner              Boolean @default(false)


}

type Church{
  churchName        String
  Address     Address
}

type Cemetry{
  cemetryName        String
  time        String
}

type Minister{
  firstName       String
  lastName        String
  phoneNo         String
}

type FamilyRep{
  firstName       String
  lastName        String
  relationship    String
  phoneNo         String
}



type Deceased{
  ffhMemberNo                 String
  lastName                    String
  firstNames                  String
  idNumber                    String
  dateOfDeath                 DateTime
  removalDate                 DateTime
  removalFrom                 Address
  deathCertificateRecipient   String
  dateOfFuneralService        DateTime


}

type Address{
  street          String
  city            String
  province        String
  zip             String
}



