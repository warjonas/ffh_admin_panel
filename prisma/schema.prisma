// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Deceased{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  ffhMemberNo                 String
  lastName                    String
  nickName            String @default("")
  firstNames                  String
  idNumber                    String
  dateOfBirth         DateTime
  dateOfDeath                 DateTime
  removalDate                 DateTime
  removalFrom                 Address
  deathCertificateRecipient   String
  createdBy                   String
 

  arrangement                 Arrangement?
  funeralProgram              FuneralProgram?
  removal                     Removal?





}

model Arrangement{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo           String
   dateOfFuneralService        DateTime?
  
  familyReps          FamilyRep[]
  deliveryAddress     String?
  deliveryTime        String?
  church              Church?
  cemetry             Cemetry?
  minister            Minister?  
  digger              Int
  crossSize           String?
  doves               Int
  liveStreaming       Int
  programs            Int?
  familyCar           Int
  bus                 Int
  storageDays         Int?
  decor               Decor?
  totalPayable        Int
  amountPaid          Int   @default(0)
  createdBy           String
  created             DateTime @default(now())
  updatedBy           String @default("")
  updated             DateTime @updatedAt()
  notes               String @default("")
  afterHour                 Int
  wreaths             Int
  doctor                 Int
  cremationDoctor                 Int
  paidUp              Boolean




  deceasedId          String @db.ObjectId @unique
  deceased            Deceased  @relation(fields: [deceasedId], references: [id])
  tombstoneId         String? @db.ObjectId
  tombstone           Tombstone? @relation(fields: [tombstoneId], references: [id])
  coffinId            String?  @db.ObjectId
  coffin              Coffin?    @relation(fields: [coffinId], references: [id])

}

model FuneralProgram {
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  survivedBy          String
  atHome              AtHome
  atChurch            AtChurch
  hymn               Hymn
  otherInformation               String
  needPallbearers     Boolean @default(true)
  pallbearersInHouse    Pallbearer[] 
  pallbearersOutHouse Pallbearer[] 
  pallbearersInChurch    Pallbearer[] 
  pallbearersOutChurch Pallbearer[] 
  pallbearersGrave    Pallbearer[] 
  languageOfProgram   String @default("")
  orbituaryText       String @default("")

  createdBy           String
  created             DateTime @default(now())
  updatedBy           String @default("")
  updated             DateTime @updatedAt()

  deceasedId          String @db.ObjectId @unique
  deceased            Deceased  @relation(fields: [deceasedId], references: [id])

}

model Removal{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  dateRequested       DateTime @default(now())
  byUndertaker        String
  deathRegistration   Int
  doctorsFees         Int
  storageFee          Int
  storageDays         Int
  graveFee            Int
  gravediggerCost     Int
  copies              Int
  copyFee             Int
  adminFees           Int
  totalDue            Int
  receipts            RemovalReceipt[]
  scheduledBy         String
  created             DateTime @default(now())
  updatedBy           String @default("")
  updated             DateTime @updatedAt()

  deceasedId          String @db.ObjectId @unique
  deceased            Deceased  @relation(fields: [deceasedId], references: [id])



}

model RemovalReceipt{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  receiptNo           String
  date                DateTime
  issuedBy            String
  methodOfPayment     String @default("EFT")
  receivedAmount      Int @default(0)
  outstandingBalance  Int
  receivedFrom        String

  removalId           String @db.ObjectId
  removal             Removal @relation(fields: [removalId],references: [id])


}



model Tombstone{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  type                String
  tombstoneName                String @default("")
  arrangements        Arrangement[]
}

model Coffin{
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  coffinName                String
  price               Int
  arrangements        Arrangement[]

}

type Pallbearer{
  firstName         String
  lastName          String

}


type Hymn{
  nameOfHymnBook      String
  hymns               HymnField[]
}

type HymnField{
  hymnNumber          Int
  detailsOfHymn       String
}

type AtHome{
  officiatingMinister   String
}

type AtChurch{
  officiatingMinister   String
  orbituary             String
  voteOfThanks          String
  otherItems            String
}

type Decor{
  candle              Boolean @default(false)
  photo               Boolean @default(false)
  glass               Boolean @default(false)
  banner              Boolean @default(false)


}

type Church{
  churchName        String
  Address     Address
}

type Cemetry{
  cemetryName        String
  time        String
}

type Minister{
  firstName       String
  lastName        String
  phoneNo         String
}

type FamilyRep{
  firstName       String
  lastName        String
  relationship    String
  phoneNo         String
}

type Address{
  street          String
  city            String
}



